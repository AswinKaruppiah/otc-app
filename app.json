{
  "expo": {
    "name": "Quotex",
    "slug": "quotex",
    "scheme": "quotex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111418",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111418"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aswinth.quotex",
      "backgroundColor": "#111418"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#111418"
      },
      "backgroundColor": "#111418",
      "edgeToEdgeEnabled": true,
      "package": "com.aswinth.quotex",
      "launchMode": "singleTask",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/logo/quotex-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/NOIR_Font/NoirPro-Regular.ttf",
            "./assets/NOIR_Font/NoirPro-Medium.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-image-picker",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9478763-394a-4fc9-8c57-dab828a17b90"
      }
    },
    "owner": "aswinths-team"
  }
}
