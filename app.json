{
  "expo": {
    "name": "currensea",
    "slug": "currensea",
    "scheme": "currensea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/currensea-logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo/currensea-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111418"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/currensea-logo.png",
        "backgroundColor": "#111418"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/logo/currensea-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
