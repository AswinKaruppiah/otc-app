{
  "expo": {
    "name": "Quotex",
    "slug": "quotex",
    "scheme": "quotex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/quotex-logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo/quotex-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111418"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/quotex-logo.png",
        "backgroundColor": "#111418"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/logo/quotex-logo.png",
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-font"]
  }
}
