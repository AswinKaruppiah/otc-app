{
  "expo": {
    "name": "Quotex",
    "slug": "quotex",
    "scheme": "quotex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111418",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo/quotex-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111418"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aswinth.quotex",
      "backgroundColor": "#111418"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#111418"
      },
      "backgroundColor": "#111418",
      "edgeToEdgeEnabled": true,
      "package": "com.aswinth.quotex",
      "launchMode": "singleTask"
    },
    "web": {
      "favicon": "./assets/logo/quotex-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/NOIR_Font/NoirPro-Regular.ttf",
            "./assets/NOIR_Font/NoirPro-Medium.ttf"
          ]
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.290463701365-h8g1tahmi1sh6ghplufj5ch9mcq15pdo"
        }
      ],
      "expo-secure-store",
      "expo-image-picker",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4f99258-7352-4028-8f45-f1751208ec7a"
      }
    }
  }
}
