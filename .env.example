# Google Sign-In client IDs (replace with your own values)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id-here.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id-here.apps.googleusercontent.com

# GraphQL API URL
EXPO_PUBLIC_GRAPHQL_API_URL=https://your-graphql-endpoint.com/graphql

# Enable/Disable API request/response logging (set to "true" to enable)
EXPO_PUBLIC_LOG_API=false
